# WanderWay Travels - Apache Server Configuration

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive config and includes directories
    RewriteRule ^(config|includes)(/.*)?$ - [F,L,NC]

    # Custom 404 routing: works in subfolder /wanderway/ and domain root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ 404.php [L]
</IfModule>

# Fallback ErrorDocument (Relative for portability)
ErrorDocument 404 404.php
